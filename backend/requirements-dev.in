# Test-only dependencies of the backend: the file to edit by hand.
# requirements-dev.txt is generated from it and contains the runtime packages
# too, at exactly the versions pinned in requirements.txt. It is for local
# development and tests only; the Docker image never installs it.
#
# After editing, regenerate from the backend/ directory:
#   uv pip compile requirements-dev.in --universal --python-version "$(cat .python-version)" --generate-hashes -o requirements-dev.txt
# If requirements.in changed, regenerate requirements.txt first (see the
# command in requirements.in).
-r requirements.in
-c requirements.txt
